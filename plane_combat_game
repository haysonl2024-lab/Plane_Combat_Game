function fireMachineGun(){
  if (gunCooldown > 0) return;
  if (crashed || !gameActive) return;
  if (isLanded) return;
  if (PARTS.weapons.hp <= 0) return;
  const wPct = PARTS.weapons.hp / PARTS.weapons.max;
  const start = playerPlane.position.clone()
    .add(new THREE.Vector3(0,0,1).applyQuaternion(playerPlane.quaternion).multiplyScalar(3))
    .add(new THREE.Vector3(0, -1.2, 0).applyQuaternion(playerPlane.quaternion));
  const fwd = new THREE.Vector3(0,0,1).applyQuaternion(playerPlane.quaternion);
  const b = new THREE.Mesh(new THREE.SphereGeometry(0.14,4,4),
    new THREE.MeshStandardMaterial({ color:0xffee66, emissive:0xaa8800 }));
  b.position.copy(start);
  b.userData = { v: fwd.clone().multiplyScalar(5.0), life:200 };
  scene.add(b); bullets.push(b);
  gunCooldown = MG_CD / (0.4 + 0.6 * wPct);
}
function fireMissile(){
  if (missileCooldown > 0) return;
  if (!lockedTarget || lockProgress < 100) return;
  if (PARTS.weapons.hp <= 0) return;
  if (isLanded || !gameActive) return;
  const fwd = new THREE.Vector3(0,0,1).applyQuaternion(playerPlane.quaternion);
  const start = playerPlane.position.clone().add(fwd.clone().multiplyScalar(4));
  const m = buildMissileModel(0xdd3333, 0xff8800);
  m.position.copy(start);
  m.lookAt(start.clone().add(fwd));
  m.userData = {
