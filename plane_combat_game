function buildRealisticPlane(bodyColor, accentColor, cockpitColor){
  const plane = new THREE.Group();
  const bodyMat    = new THREE.MeshStandardMaterial({ color: bodyColor,  metalness:0.6, roughness:0.4, flatShading:true });
  const accentMat  = new THREE.MeshStandardMaterial({ color: accentColor, metalness:0.6, roughness:0.35, flatShading:true });
  const darkMat    = new THREE.MeshStandardMaterial({ color: 0x0a0a0a, metalness:0.85, roughness:0.25, flatShading:true });
  const panelMat   = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, metalness:0.75, roughness:0.5 });
  const glassMat   = new THREE.MeshPhysicalMaterial({
    color: cockpitColor, metalness: 0.9, roughness: 0.05,
    transmission: 0.4, transparent: true, opacity: 0.6,
    clearcoat: 1.0, clearcoatRoughness: 0.05
  });

  const fusShape = new THREE.Shape();
  fusShape.moveTo(-0.35, -3.4);
  fusShape.lineTo( 0.35, -3.4);
  fusShape.lineTo( 0.95, -2.0);
  fusShape.lineTo( 1.05, -0.2);
  fusShape.lineTo( 0.85,  1.6);
  fusShape.lineTo( 0.35,  2.9);
  fusShape.lineTo( 0.00,  3.5);
  fusShape.lineTo(-0.35,  2.9);
  fusShape.lineTo(-0.85,  1.6);
  fusShape.lineTo(-1.05, -0.2);
  fusShape.lineTo(-0.95, -2.0);
  fusShape.closePath();

  const fusGeo = new THREE.ExtrudeGeometry(fusShape, {
    depth: 0.62, bevelEnabled: true,
    bevelThickness: 0.08, bevelSize: 0.08, bevelSegments: 2
  });
  const fuselage = new THREE.Mesh(fusGeo, bodyMat);
  fuselage.rotation.x = -Math.PI / 2;
  fuselage.position.y = 0.30;
  plane.add(fuselage);

  function makeWing(side){
    const shape = new THREE.Shape();
    shape.moveTo(0.95 * side,  1.2);
    shape.lineTo(3.6  * side, -0.75);
    shape.lineTo(3.4  * side, -1.45);
    shape.lineTo(0.95 * side, -1.9);
    shape.closePath();
    const geo = new THREE.ExtrudeGeometry(shape, {
      depth: 0.16, bevelEnabled: true, bevelThickness:0.03, bevelSize:0.03, bevelSegments:2
    });
    const wing = new THREE.Mesh(geo, bodyMat);
    wing.rotation.x = -Math.PI / 2;
    wing.rotation.z = -side * 0.04;
    wing.position.set(0, 0.20, 0);
    return wing;
  }
  plane.add(makeWing(1));
  plane.add(makeWing(-1));

  function makeWingEdge(side){
    const shape = new THREE.Shape();
    shape.moveTo(0.95 * side, 1.2);
    shape.lineTo(3.6  * side, -0.75);
    shape.lineTo(3.6  * side, -0.95);
    shape.lineTo(0.95 * side, 1.0);
    shape.closePath();
    const geo = new THREE.ExtrudeGeometry(shape, { depth: 0.02, bevelEnabled: false });
    const edge = new THREE.Mesh(geo, accentMat);
    edge.rotation.x = -Math.PI / 2;
    edge.position.set(0, 0.30, 0);
    return edge;
  }
  plane.add(makeWingEdge(1));
  plane.add(makeWingEdge(-1));

  function makeWingTip(side){
    const tip = new THREE.Group();
    const pod = new THREE.Mesh(new THREE.CylinderGeometry(0.10, 0.10, 1.0, 10), darkMat);
    pod.rotation.x = Math.PI / 2;
    tip.add(pod);
    const noseCone = new THREE.Mesh(new THREE.ConeGeometry(0.10, 0.28, 10), accentMat);
    noseCone.rotation.x = Math.PI / 2;
    noseCone.position.z = 0.63;
    tip.add(noseCone);
    tip.position.set(3.55 * side, 0.25, -0.9);
    return tip;
  }
  plane.add(makeWingTip(1));
  plane.add(makeWingTip(-1));

  function makeHorizontalStab(side){
    const shape = new THREE.Shape();
    shape.moveTo(0.75 * side, -1.9);
    shape.lineTo(2.15 * side, -2.9);
    shape.lineTo(2.0  * side, -3.3);
    shape.lineTo(0.75 * side, -3.3);
    shape.closePath();
    const geo = new THREE.ExtrudeGeometry(shape, { depth: 0.10, bevelEnabled: false });
    const stab = new THREE.Mesh(geo, bodyMat);
    stab.rotation.x = -Math.PI / 2;
    stab.rotation.z = -side * 0.05;
    stab.position.y = 0.22;
    return stab;
  }
  plane.add(makeHorizontalStab(1));
  plane.add(makeHorizontalStab(-1));

  function makeVerticalFin(side){
    const finShape = new THREE.Shape();
    finShape.moveTo(0, 0);
    finShape.lineTo(0.9, -0.15);
    finShape.lineTo(1.15, 1.15);
    finShape.lineTo(0.55, 1.20);
    finShape.lineTo(0.15, 0.45);
    finShape.closePath();
    const finGeo = new THREE.ExtrudeGeometry(finShape, { depth: 0.06, bevelEnabled: false });
    const fin = new THREE.Mesh(finGeo, bodyMat);
    fin.position.set(0.75 * side, 0.55, -2.6);
    fin.rotation.y = Math.PI / 2;
    fin.rotation.z = side * 0.22;
    return fin;
  }
  plane.add(makeVerticalFin(1));
  plane.add(makeVerticalFin(-1));

  const canopyGeo = new THREE.SphereGeometry(0.55, 18, 12, 0, Math.PI*2, 0, Math.PI * 0.45);
  const canopy = new THREE.Mesh(canopyGeo, glassMat);
  canopy.scale.set(0.75, 0.6, 2.0);
  canopy.position.set(0, 0.72, 1.0);
  plane.add(canopy);

  const frame = new THREE.Mesh(
    new THREE.TorusGeometry(0.55, 0.03, 8, 20),
    panelMat
  );
  frame.rotation.x = -Math.PI / 2;
  frame.scale.set(0.75, 2.0, 1);
  frame.position.set(0, 0.72, 1.0);
  plane.add(frame);

  const noseTip = new THREE.Mesh(new THREE.ConeGeometry(0.12, 0.45, 12), darkMat);
  noseTip.rotation.x = Math.PI / 2;
  noseTip.position.set(0, 0.30, 3.6);
  plane.add(noseTip);

  function makeNozzle(side){
    const outer = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.32, 0.55, 12), darkMat);
    outer.rotation.x = Math.PI / 2;
    outer.position.set(0.42 * side, 0.30, -3.3);
    plane.add(outer);
    const inner = new THREE.Mesh(new THREE.CircleGeometry(0.25, 14),
      new THREE.MeshBasicMaterial({ color: 0xffaa44 }));
    inner.rotation.y = Math.PI;
    inner.position.set(0.42 * side, 0.30, -3.58);
    plane.add(inner);
  }
  makeNozzle(1);
  makeNozzle(-1);

  const intakeL = new THREE.Mesh(new THREE.BoxGeometry(0.35, 0.22, 1.2), darkMat);
  intakeL.position.set(-0.75, 0.05, 0.6);
  plane.add(intakeL);
  const intakeR = new THREE.Mesh(new THREE.BoxGeometry(0.35, 0.22, 1.2), darkMat);
  intakeR.position.set(0.75, 0.05, 0.6);
  plane.add(intakeR);

  function lightDot(side, color){
    const dot = new THREE.Mesh(new THREE.SphereGeometry(0.09, 8, 8),
      new THREE.MeshBasicMaterial({ color: color }));
    dot.position.set(3.55 * side, 0.28, -0.9);
    return dot;
  }
  plane.add(lightDot( 1, 0x00ff44));
  plane.add(lightDot(-1, 0xff2222));

  return plane;
}

