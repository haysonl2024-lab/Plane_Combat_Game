  for (let i = 0; i < 4; i++){
    const fin = new THREE.Mesh(finGeo, finMat);
    const angle = i * Math.PI / 2;
    fin.position.set(Math.cos(angle) * 0.25, Math.sin(angle) * 0.25, -0.85);
    fin.rotation.z = angle;
    missile.add(fin);
  }

  const innerFlame = new THREE.Mesh(new THREE.ConeGeometry(0.18, 0.7, 8),
    new THREE.MeshBasicMaterial({ color: 0xffffaa, transparent: true, opacity: 0.95 }));
  innerFlame.rotation.x = -Math.PI / 2;
  innerFlame.position.z = -1.4;
  missile.add(innerFlame);

  const outerFlame = new THREE.Mesh(new THREE.ConeGeometry(0.32, 1.1, 8),
    new THREE.MeshBasicMaterial({ color: flameColor, transparent: true, opacity: 0.65 }));
  outerFlame.rotation.x = -Math.PI / 2;
  outerFlame.position.z = -1.55;
  missile.add(outerFlame);

  missile.userData.innerFlame = innerFlame;
  missile.userData.outerFlame = outerFlame;

  const light = new THREE.PointLight(flameColor, 2.0, 15);
  light.position.z = -1.2;
  missile.add(light);

  return missile;
}

