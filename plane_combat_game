// ================= TERRAIN =================
const GROUND_SIZE = 6000;
const SEG = 200;
const groundGeo = new THREE.PlaneGeometry(GROUND_SIZE, GROUND_SIZE, SEG, SEG);
groundGeo.rotateX(-Math.PI/2);

const heights = [];
const rows = SEG + 1, cols = SEG + 1;
for (let r=0;r<rows;r++) heights.push(new Array(cols).fill(0));

function smoothNoise(x, z, scale, offset){
  return Math.sin((x+offset)*0.013*scale) * Math.cos((z+offset)*0.011*scale)
       + Math.sin((x+offset)*0.027*scale) * 0.5
       + Math.cos((x+offset)*0.019*scale) * 0.7;
}
function biomeAt(x, z){
  const n = Math.sin(x*0.0004 + 12.3) + Math.cos(z*0.0005 + 4.7);
  if (n < -0.6) return 'desert';
  if (n < -0.05) return 'grass';
  if (n < 0.5) return 'forest';
  return 'rock';
}

const HIGHWAY_HALF_WIDTH = 60;
const HIGHWAY_HALF_LENGTH = 1600;

const positions = groundGeo.attributes.position;
for (let r=0;r<rows;r++){
  for (let c=0;c<cols;c++){
    const i = r*cols + c;
    const x = positions.getX(i);
    const z = positions.getZ(i);
    const distFromCenter = Math.sqrt(x*x + z*z);
    let h = smoothNoise(x, z, 1, 0) * 22;
    h += smoothNoise(x, z, 2, 800) * 12;
    h += smoothNoise(x, z, 3, 1600) * 5;
    const ridge = Math.max(0, (distFromCenter - 250) / 900);
    h *= (0.3 + ridge * 1.7);
    if (distFromCenter < 200){ const t = distFromCenter / 200; h = h * t * t; }
    const biome = biomeAt(x, z);
    if (biome === 'desert') h *= 0.4;
    if (biome === 'rock') h *= 1.6;
    if (h < 0) h = Math.max(h, -4);

    if (Math.abs(x) < HIGHWAY_HALF_WIDTH + 20 && Math.abs(z) < HIGHWAY_HALF_LENGTH + 20){
      const blendX = Math.min(1, Math.max(0, (HIGHWAY_HALF_WIDTH + 20 - Math.abs(x)) / 20));
      const blendZ = Math.min(1, Math.max(0, (HIGHWAY_HALF_LENGTH + 20 - Math.abs(z)) / 20));
      const blend = Math.min(blendX, blendZ);
      h = h * (1 - blend) + 0.3 * blend;
    }

    positions.setY(i, h);
    heights[r][c] = h;
  }
}
groundGeo.computeVertexNormals();

const colors = [];
for (let r=0;r<rows;r++){
  for (let c=0;c<cols;c++){
    const i = r*cols + c;
    const x = positions.getX(i);
    const z = positions.getZ(i);
    const h = heights[r][c];
    const biome = biomeAt(x, z);
    let color;
    if (h < -0.5) color = new THREE.Color(0x3388cc);
    else if (h < 1) color = new THREE.Color(0xddc088);
    else if (h > 30) color = new THREE.Color(0xffffff);
    else if (biome === 'desert') color = new THREE.Color(0xe8c88a);
    else if (biome === 'forest') color = new THREE.Color(0x2a6a2a);
    else if (biome === 'grass') color = new THREE.Color(0x6aaa4a);
    else color = new THREE.Color(0x7a6a5a);

    if (Math.abs(x) < HIGHWAY_HALF_WIDTH && Math.abs(z) < HIGHWAY_HALF_LENGTH){
      color = new THREE.Color(0x3a3a3e);
    }

    colors.push(color.r, color.g, color.b);
  }
}
groundGeo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

const ground = new THREE.Mesh(groundGeo, new THREE.MeshStandardMaterial({
  vertexColors: true, flatShading: true, roughness: 1, metalness: 0
}));
scene.add(ground);

const waterGeo = new THREE.PlaneGeometry(GROUND_SIZE, GROUND_SIZE);
waterGeo.rotateX(-Math.PI/2);
const water = new THREE.Mesh(waterGeo, new THREE.MeshStandardMaterial({
  color: 0x2a6fa8, transparent: true, opacity: 0.75, roughness: 0.2, metalness: 0.4
}));
water.position.y = -0.5;
scene.add(water);

function terrainHeightAt(x, z){
  const half = GROUND_SIZE / 2;
  if (x < -half || x > half || z < -half || z > half) return 0;
  const cellSize = GROUND_SIZE / SEG;
  const fx = (x + half) / cellSize;
  const fz = (z + half) / cellSize;
  const c0 = Math.floor(fx), r0 = Math.floor(fz);
  const c1 = Math.min(c0 + 1, SEG), r1 = Math.min(r0 + 1, SEG);
  const tx = fx - c0, tz = fz - r0;
  const h00 = heights[r0][c0], h10 = heights[r0][c1];
  const h01 = heights[r1][c0], h11 = heights[r1][c1];
  const h0 = h00 * (1 - tx) + h10 * tx;
  const h1 = h01 * (1 - tx) + h11 * tx;
  return h0 * (1 - tz) + h1 * tz;
}

function addTree(x, z){
  const y = terrainHeightAt(x, z);
  if (y < 1 || y > 25) return;
  if (Math.abs(x) < HIGHWAY_HALF_WIDTH + 10) return;
  const tree = new THREE.Group();
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.8, 5, 6),
    new THREE.MeshStandardMaterial({ color:0x5a3a1a }));
  trunk.position.y = 2.5; tree.add(trunk);
  const leaves = new THREE.Mesh(new THREE.ConeGeometry(3.5, 8, 8),
    new THREE.MeshStandardMaterial({ color:0x1f5f1f }));
  leaves.position.y = 7; tree.add(leaves);
  tree.position.set(x, y, z);
  scene.add(tree);
}
let treeCount = 0;
for (let a = 0; a < 900 && treeCount < 400; a++){
  const x = (Math.random() - 0.5) * GROUND_SIZE * 0.85;
  const z = (Math.random() - 0.5) * GROUND_SIZE * 0.85;
  if (biomeAt(x, z) === 'forest'){ addTree(x, z); treeCount++; }
}
function addCactus(x, z){
  const y = terrainHeightAt(x, z);
  if (y < 0 || y > 15) return;
  if (Math.abs(x) < HIGHWAY_HALF_WIDTH + 10) return;
  const cactus = new THREE.Mesh(new THREE.CylinderGeometry(0.7, 0.9, 5, 6),
    new THREE.MeshStandardMaterial({ color:0x2a7a3a }));
  cactus.position.set(x, y + 2.5, z);
