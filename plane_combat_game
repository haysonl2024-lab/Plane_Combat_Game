for (let a = 0; a < 500 && cactusCount < 200; a++){
  const x = (Math.random() - 0.5) * GROUND_SIZE * 0.85;
  const z = (Math.random() - 0.5) * GROUND_SIZE * 0.85;
  if (biomeAt(x, z) === 'desert' && terrainHeightAt(x, z) > 0.5){
    addCactus(x, z); cactusCount++;
  }
}

