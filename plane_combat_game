<script type="module">
import * as THREE from 'three';

// ================= PLANE DEFINITIONS =================
const PLANE_TYPES = {
  f22: {
    name: 'F-22 RAPTOR',
    bodyColor: 0x8a95a0,
    accentColor: 0xb8c4d0,
    cockpitColor: 0x88ddff,
    speedMod: 1.15,
    turnMod: 1.10
  },
  j20: {
    name: 'J-20 MIGHTY DRAGON',
    bodyColor: 0x3a3f47,
    accentColor: 0xc03030,
    cockpitColor: 0xaaddff,
    speedMod: 1.00,
    turnMod: 0.90
  },
  f35: {
    name: 'F-35 LIGHTNING',
    bodyColor: 0x4a5a68,
    accentColor: 0xa0b0c0,
    cockpitColor: 0x88ccff,
    speedMod: 1.05,
    turnMod: 1.05
  }
};
let selectedPlane = 'f22';

// ================= PREVIEW RENDERERS =================
function drawPlanePreview(canvas, key){
  const p = PLANE_TYPES[key];
  const c = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  c.clearRect(0, 0, W, H);

  const grad = c.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0, '#0a1a2a');
  grad.addColorStop(1, '#1a3a5a');
  c.fillStyle = grad;
  c.fillRect(0, 0, W, H);

  const bodyC = '#' + p.bodyColor.toString(16).padStart(6,'0');
  const accC  = '#' + p.accentColor.toString(16).padStart(6,'0');

  c.save();
  c.translate(W/2, H/2);
  c.scale(0.65, 0.65);

