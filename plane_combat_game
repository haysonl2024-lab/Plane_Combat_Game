    target: lockedTarget,
    life: 900,
    smokeTimer: 0,
    willMiss: Math.random() < MISSILE_MISS_CHANCE,
    missPhase: 0,
    missDir: new THREE.Vector3(
      (Math.random() - 0.5),
      (Math.random() - 0.5),
      (Math.random() - 0.5)
    ).normalize()
  };
  scene.add(m); missiles.push(m);
  missileCooldown = missileCD;
  lockHud.classList.remove('locked');
}
function fireFlare(){
  if (flareCooldown > 0) return;
  if (crashed || !gameActive) return;
  flareCooldown = FLARE_COOLDOWN;

  const backDir = new THREE.Vector3(0, 0, -1).applyQuaternion(playerPlane.quaternion);
  const rightDir = new THREE.Vector3(1, 0, 0).applyQuaternion(playerPlane.quaternion);
  const upDir = new THREE.Vector3(0, 1, 0).applyQuaternion(playerPlane.quaternion);

  for (let i = 0; i < 12; i++){
    const flare = new THREE.Group();
    const glowMat = new THREE.MeshBasicMaterial({ color: 0xffdd44, transparent: true, opacity: 1 });
    const glow = new THREE.Mesh(new THREE.SphereGeometry(0.5, 8, 8), glowMat);
    flare.add(glow);
    const light = new THREE.PointLight(0xffcc33, 3, 30);
    flare.add(light);

    const startPos = playerPlane.position.clone().add(backDir.clone().multiplyScalar(3));
    const vel = backDir.clone().multiplyScalar(1.2);
    vel.add(rightDir.clone().multiplyScalar((Math.random() - 0.5) * 2.0));
    vel.add(upDir.clone().multiplyScalar((Math.random() - 0.5) * 1.5));
    vel.y -= 0.4;

    flare.position.copy(startPos);
    flare.userData = { v: vel, life: 200, maxLife: 200, isFlare: true };
    scene.add(flare);
    flares.push(flare);
    spawnSmoke(startPos, 1.2, 0xffbb44, 1.5);
  }
  showBigMessage('🎆 FLARES DEPLOYED', '10s COOLDOWN', 1000);
