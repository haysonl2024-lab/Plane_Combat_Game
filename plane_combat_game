function steerPlaneToward(plane, targetDir, pitchRate, yawRate, frameFactor){
  const forward = new THREE.Vector3(0, 0, 1).applyQuaternion(plane.quaternion);
  const toTarget = targetDir.clone().normalize();
  const forwardHorizontal = new THREE.Vector3(forward.x, 0, forward.z).normalize();
  const targetHorizontal  = new THREE.Vector3(toTarget.x, 0, toTarget.z).normalize();
  const dotH = forwardHorizontal.dot(targetHorizontal);
  const crossH = forwardHorizontal.clone().cross(targetHorizontal);
  const yawError = Math.atan2(crossH.y, dotH);
  const verticalAngleCurrent = Math.asin(THREE.MathUtils.clamp(forward.y, -1, 1));
  const verticalAngleTarget  = Math.asin(THREE.MathUtils.clamp(toTarget.y, -1, 1));
  const pitchError = verticalAngleTarget - verticalAngleCurrent;
  const yawAmount   = THREE.MathUtils.clamp(-yawError,   -yawRate * frameFactor, yawRate * frameFactor);
  const pitchAmount = THREE.MathUtils.clamp(-pitchError, -pitchRate * frameFactor, pitchRate * frameFactor);
  plane.rotateY(yawAmount);
  plane.rotateX(pitchAmount);
}
