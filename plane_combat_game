const smokePuffs = [];
const SMOKE_POOL_SIZE = 250;
function makeSmokeTexture(){
  const size = 64;
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  const grad = ctx.createRadialGradient(size/2, size/2, 2, size/2, size/2, size/2);
  grad.addColorStop(0, 'rgba(255,255,255,0.9)');
  grad.addColorStop(0.3, 'rgba(230,230,230,0.6)');
  grad.addColorStop(0.7, 'rgba(180,180,180,0.25)');
  grad.addColorStop(1, 'rgba(150,150,150,0)');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, size, size);
  return new THREE.CanvasTexture(c);
}
const smokeTex = makeSmokeTexture();
for (let i = 0; i < SMOKE_POOL_SIZE; i++){
  const mat = new THREE.SpriteMaterial({ map: smokeTex, transparent: true, opacity: 0, depthWrite: false, color: 0xffffff });
  const spr = new THREE.Sprite(mat);
  spr.visible = false;
  spr.userData = { active: false, life: 0, maxLife: 1, velocity: new THREE.Vector3(), startScale: 1, endScale: 2 };
  scene.add(spr);
  smokePuffs.push(spr);
}
function spawnSmoke(position, size = 1, color = 0xcccccc, life = 1.2){
  for (const p of smokePuffs){
    if (!p.userData.active){
      p.userData.active = true;
      p.position.copy(position);
      p.userData.life = life;
      p.userData.maxLife = life;
      p.userData.startScale = size;
      p.userData.endScale = size * 3.0;
      p.userData.velocity.set((Math.random() - 0.5) * 0.15, (Math.random() - 0.5) * 0.15, (Math.random() - 0.5) * 0.15);
      p.material.color.setHex(color);
      p.material.opacity = 0.85;
      p.scale.set(size, size, 1);
      p.visible = true;
      return;
    }
  }
}
function updateSmoke(frameFactor){
  for (const p of smokePuffs){
    if (!p.userData.active) continue;
    p.userData.life -= 0.016 * frameFactor;
    if (p.userData.life <= 0){ p.userData.active = false; p.visible = false; continue; }
    const t = 1 - (p.userData.life / p.userData.maxLife);
    p.position.add(p.userData.velocity.clone().multiplyScalar(frameFactor));
    const scale = p.userData.startScale + (p.userData.endScale - p.userData.startScale) * t;
    p.scale.set(scale, scale, 1);
    p.material.opacity = 0.85 * (1 - t);
  }
}

