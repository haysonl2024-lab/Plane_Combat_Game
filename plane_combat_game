// ================= LANDING =================
function terrainSlopeAt(x, z){
  const d = 4;
  const hL = terrainHeightAt(x - d, z);
  const hR = terrainHeightAt(x + d, z);
  const hU = terrainHeightAt(x, z - d);
  const hD = terrainHeightAt(x, z + d);
  const dhx = (hR - hL) / (2 * d);
  const dhz = (hD - hU) / (2 * d);
  return Math.sqrt(dhx*dhx + dhz*dhz);
}
function tryLanding(groundY){
  const currentSpeedPct = speedMultiplier;
  if (currentSpeedPct > 0.65) return false;
  const fwd = new THREE.Vector3(0,0,1).applyQuaternion(playerPlane.quaternion);
  if (fwd.y < -0.35) return false;
  const up = new THREE.Vector3(0,1,0).applyQuaternion(playerPlane.quaternion);
  if (up.y < 0.65) return false;
  const slope = terrainSlopeAt(playerPlane.position.x, playerPlane.position.z);
  if (slope > 0.35) return false;
  return true;
}
function landedSuccessfully(){
  isLanded = true;
  landedTimer = LANDED_DURATION;
  PARTS.wings.hp   = PARTS.wings.max;
  PARTS.engine.hp  = PARTS.engine.max;
  PARTS.weapons.hp = Math.min(PARTS.weapons.max, PARTS.weapons.hp + 50);
  updatePartHUD();
  const groundY = terrainHeightAt(playerPlane.position.x, playerPlane.position.z);
  playerPlane.position.y = groundY + 1.4;
  showBigMessage('🛬 LANDED SAFELY', 'PLANE REPAIRED — TAKING OFF SOON', 2500);
  landStatusEl.classList.add('show');
  landStatusEl.textContent = 'LANDED ✓';
}

// ================= RADAR =================
function drawRadar(){
  const S = RADAR_SIZE, C = S / 2;
  radarCtx.clearRect(0, 0, S, S);
  radarCtx.fillStyle = 'rgba(0, 30, 0, 0.9)';
  radarCtx.beginPath();
  radarCtx.arc(C, C, C - 1, 0, Math.PI * 2);
  radarCtx.fill();
  radarCtx.strokeStyle = 'rgba(80, 255, 80, 0.35)';
  radarCtx.lineWidth = 1;
  for (let i = 1; i <= 3; i++){
    radarCtx.beginPath();
    radarCtx.arc(C, C, (C - 4) * (i / 3), 0, Math.PI * 2);
    radarCtx.stroke();
  }
  radarCtx.beginPath();
  radarCtx.moveTo(C, 4); radarCtx.lineTo(C, S - 4);
  radarCtx.moveTo(4, C); radarCtx.lineTo(S - 4, C);
  radarCtx.stroke();
  const sweepAngle = (performance.now() * 0.001) % (Math.PI * 2);
  radarCtx.strokeStyle = 'rgba(120, 255, 120, 0.6)';
  radarCtx.lineWidth = 2;
  radarCtx.beginPath();
  radarCtx.moveTo(C, C);
  radarCtx.lineTo(C + Math.cos(sweepAngle) * (C - 4), C + Math.sin(sweepAngle) * (C - 4));
  radarCtx.stroke();

  const forward = new THREE.Vector3(0,0,1).applyQuaternion(playerPlane.quaternion);
  const headingAngle = Math.atan2(forward.x, forward.z);
  const cosH = Math.cos(-headingAngle), sinH = Math.sin(-headingAngle);
  function worldToRadar(worldPos){
    const dx = worldPos.x - playerPlane.position.x;
    const dz = worldPos.z - playerPlane.position.z;
    const rx = dx * cosH - dz * sinH;
    const rz = dx * sinH + dz * cosH;
    const scale = (C - 4) / RADAR_RANGE;
    return { x: C + rx * scale, y: C - rz * scale, dist: Math.sqrt(dx*dx + dz*dz) };
  }
  for (const e of enemies){
    const p = worldToRadar(e.position);
    if (p.dist > RADAR_RANGE) continue;
    const isLocked = (lockedTarget === e);
    const isLockingMe = e.userData.lockProgress > 30;
    radarCtx.fillStyle = isLocked ? '#ffaa00' : (isLockingMe ? '#ff00ff' : '#ff3333');
    radarCtx.beginPath();
    radarCtx.arc(p.x, p.y, isLocked ? 4 : 3, 0, Math.PI * 2);
    radarCtx.fill();
  }
  for (const g of groundEnemies){
    const p = worldToRadar(g.position);
    if (p.dist > RADAR_RANGE) continue;
    radarCtx.fillStyle = '#ff8822';
    radarCtx.fillRect(p.x - 2.5, p.y - 2.5, 5, 5);
  }
  for (const u of fleetUnits){
    if (!u.mesh.parent) continue;
    const p = worldToRadar(u.mesh.position);
    if (p.dist > RADAR_RANGE) continue;
    radarCtx.fillStyle = '#ff44aa';
    radarCtx.fillRect(p.x - 2.5, p.y - 2.5, 5, 5);
  }
  for (const b of bosses){
    const p = worldToRadar(b.position);
    if (p.dist > RADAR_RANGE) continue;
    radarCtx.fillStyle = '#ff0000';
    radarCtx.beginPath();
    radarCtx.arc(p.x, p.y, 6, 0, Math.PI * 2);
    radarCtx.fill();
    radarCtx.strokeStyle = '#ffff00';
    radarCtx.lineWidth = 2;
    radarCtx.stroke();
  }
  for (const fl of flares){
    const p = worldToRadar(fl.position);
    if (p.dist > RADAR_RANGE) continue;
    radarCtx.fillStyle = '#ffee55';
    radarCtx.beginPath();
    radarCtx.arc(p.x, p.y, 2, 0, Math.PI * 2);
    radarCtx.fill();
  }

  radarCtx.fillStyle = '#44aaff';
  radarCtx.beginPath();
  radarCtx.moveTo(C, C - 7);
  radarCtx.lineTo(C - 4, C + 4);
  radarCtx.lineTo(C + 4, C + 4);
  radarCtx.closePath();
  radarCtx.fill();
}

// ================= MAIN LOOP =================
const clock = new THREE.Clock();
const tmpForward = new THREE.Vector3();
const tmpTarget = new THREE.Vector3();

function animate(){
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);
  const f = dt * 60;

  if (!gameActive){ renderer.render(scene, camera); return; }

  if (invulnerableTimer > 0){
    invulnerableTimer -= f;
    if (!firstPerson){
      playerPlane.visible = (Math.floor(invulnerableTimer / 6) % 2 === 0);
      if (invulnerableTimer <= 0){ invulnerableTimer = 0; playerPlane.visible = true; }
    }
  }

  if (isLanded){
    landedTimer -= f;
    if (landedTimer <= 0){
      isLanded = false;
      landStatusEl.classList.remove('show');
      playerPlane.position.y += 5;
      playerPlane.rotateX(-0.2);
      speedMultiplier = 1.0;
      showBigMessage('✈️ TAKING OFF', '', 1200);
    }
  }

  if (!crashed && !isLanded){
    if (keys.faster) speedMultiplier = Math.min(3.0, speedMultiplier + 0.015 * f);
    if (keys.slower) speedMultiplier = Math.max(0.3, speedMultiplier - 0.015 * f);

    let pitchIn = 0, yawIn = 0;
    if (keys.up)    pitchIn += 1;
    if (keys.down)  pitchIn -= 1;
    if (keys.left)  yawIn   += 1;
    if (keys.right) yawIn   -= 1;
    if (joyActive){
      pitchIn = -joyVecY;
      yawIn   = -joyVecX;
    }
    const planeStats = PLANE_TYPES[selectedPlane];
    const wingPct  = PARTS.wings.hp / PARTS.wings.max;
    const enginePct = PARTS.engine.hp / PARTS.engine.max;
    const wingFactor   = (0.3 + 0.7 * wingPct) * planeStats.turnMod;
    const engineFactor = (0.4 + 0.6 * enginePct) * planeStats.speedMod;

    playerPlane.rotateX( pitchSpeed * pitchIn * wingFactor * f);
    playerPlane.rotateY( yawSpeed   * yawIn   * wingFactor * f);

    tmpForward.set(0,0,1).applyQuaternion(playerPlane.quaternion);
    playerPlane.position.add(tmpForward.clone().multiplyScalar(BASE_SPEED * speedMultiplier * engineFactor * f));
    altValueEl.textContent = Math.floor(playerPlane.position.y);
    speedValueEl.textContent = Math.round(speedMultiplier * 100 * engineFactor);

    const groundY = terrainHeightAt(playerPlane.position.x, playerPlane.position.z);
    if (playerPlane.position.y <= groundY + 1.2){
      if (tryLanding(groundY)){
        landedSuccessfully();
      } else {
        endGame('💥 CRASHED', 'Landing was too steep or fast.');
      }
    }
  }

  if (!crashed){
    const fwd2 = new THREE.Vector3(0,0,1).applyQuaternion(playerPlane.quaternion);
    if (firstPerson){
      if (playerCockpit){
        playerCockpit.position.copy(playerPlane.position);
        playerCockpit.quaternion.copy(playerPlane.quaternion);
      }
      const eyeLocal = new THREE.Vector3(0, 0.05, 0.05);
      const eyeWorld = eyeLocal.clone().applyQuaternion(playerPlane.quaternion).add(playerPlane.position);
      camera.position.copy(eyeWorld);

      const planeForward = new THREE.Vector3(0,0,1).applyQuaternion(playerPlane.quaternion);
      const planeUp      = new THREE.Vector3(0,1,0).applyQuaternion(playerPlane.quaternion);
      const planeRight   = new THREE.Vector3(1,0,0).applyQuaternion(playerPlane.quaternion);

      const headQ = new THREE.Quaternion().setFromAxisAngle(planeUp, headYaw);
      const pitched = planeForward.clone().applyQuaternion(headQ);
      const pitchQ = new THREE.Quaternion().setFromAxisAngle(planeRight, headPitch);
      pitched.applyQuaternion(pitchQ);

      const lookAt = camera.position.clone().add(pitched.multiplyScalar(10));
      camera.up.copy(planeUp);
      camera.lookAt(lookAt);
    } else {
      if (!isDragging){
        camYaw   *= (1 - 0.02 * f);
        camPitch += (0.35 - camPitch) * 0.02 * f;
      }
      const localOffset = new THREE.Vector3(
        Math.sin(camYaw) * Math.cos(camPitch),
        Math.sin(camPitch),
        -Math.cos(camYaw) * Math.cos(camPitch)
      ).multiplyScalar(camDistance);
      const worldOffset = localOffset.clone().applyQuaternion(playerPlane.quaternion);
      camera.position.lerp(playerPlane.position.clone().add(worldOffset), 0.5 * f);
      camera.up.set(0, 1, 0);
      camera.lookAt(playerPlane.position.clone().add(fwd2.clone().multiplyScalar(6)));
    }
  }

  if (missileCooldown > 0) missileCooldown -= f;
  if (gunCooldown > 0) gunCooldown -= f;
  if (keys.machineGun && !crashed) fireMachineGun();
  if (!crashed) updatePlayerLock(dt);

  if (flareCooldown > 0){
    flareCooldown -= f;
    if (flareCooldown < 0) flareCooldown = 0;
  }
  if (flareCooldown > 0){
    const secs = Math.ceil(flareCooldown / 60);
    flareStatusEl.textContent = 'FLARES: ' + secs + 's';
    btnFlareEl.classList.add('cooling');
  } else {
    flareStatusEl.textContent = 'FLARES: READY';
    btnFlareEl.classList.remove('cooling');
  }

  for (let i = flares.length - 1; i >= 0; i--){
    const fl = flares[i];
    fl.userData.life -= f;
    fl.userData.v.y -= 0.008 * f;
    fl.position.add(fl.userData.v.clone().multiplyScalar(f));
    const t = fl.userData.life / fl.userData.maxLife;
    if (fl.children[0] && fl.children[0].material) fl.children[0].material.opacity = t;
    if (fl.children[1] && fl.children[1].isPointLight) fl.children[1].intensity = 3 * t;
    if (Math.random() < 0.15) spawnSmoke(fl.position, 0.6, 0xffcc44, 0.8);
    if (fl.userData.life <= 0){ scene.remove(fl); flares.splice(i, 1); }
  }

  let enemyLockingNow = false;
  for (const e of enemies) if (e.userData.lockProgress > 30 && e.userData.lockProgress < 100){ enemyLockingNow = true; break; }
  for (const g of groundEnemies) if (g.userData.lockProgress > 30 && g.userData.lockProgress < 100){ enemyLockingNow = true; break; }
  for (const u of fleetUnits) if (u.lockProgress > 30 && u.lockProgress < 100){ enemyLockingNow = true; break; }
  if (enemyLockingNow || enemyMissiles.length > 0){ topLockWarning.classList.add('show'); }
  else { topLockWarning.classList.remove('show'); }

  for (let i=bullets.length-1; i>=0; i--){
    const b = bullets[i];
    if (b.userData.v) b.position.add(b.userData.v.clone().multiplyScalar(f));
    b.userData.life -= f;
    if (b.userData.life <= 0 || b.position.distanceTo(playerPlane.position) > 800){
      scene.remove(b); bullets.splice(i,1);
    }
  }
  for (let i=enemyBullets.length-1; i>=0; i--){
    const b = enemyBullets[i];
    if (b.userData.v) b.position.add(b.userData.v.clone().multiplyScalar(f));
    b.userData.life -= f;
    if (!crashed && !isLanded && b.position.distanceTo(playerPlane.position) < 2.5){
      explode(b.position); scene.remove(b); enemyBullets.splice(i,1);
      playerHit('bullet'); continue;
    }
    if (b.userData.life <= 0){ scene.remove(b); enemyBullets.splice(i,1); }
  }
  for (let i=particles.length-1; i>=0; i--){
    const p = particles[i];
    p.position.add(p.userData.v.clone().multiplyScalar(f));
    p.userData.life -= f;
    if (p.userData.life <= 0){ scene.remove(p); particles.splice(i,1); }
  }

  for (let i=missiles.length-1; i>=0; i--){
    const m = missiles[i];
    const tgt = m.userData.target;
    const inner = m.userData.innerFlame, outer = m.userData.outerFlame;
    if (inner && outer){
      const flicker = 0.85 + Math.random() * 0.3;
      inner.scale.setScalar(flicker); outer.scale.setScalar(flicker);
    }
    if (m.userData.willMiss){
      m.userData.missPhase += f;
      if (m.userData.missPhase > 60){
        const desired = tgt && tgt.parent
          ? tgt.position.clone().sub(m.position).normalize().multiplyScalar(2.4)
          : m.userData.v.clone().normalize().multiplyScalar(2.4);
        desired.lerp(m.userData.missDir.clone().multiplyScalar(4.0), 0.3);
        m.userData.v.lerp(desired, 0.10 * f);
        m.lookAt(m.position.clone().add(m.userData.v));
      } else if (tgt && tgt.parent){
        const desired = tgt.position.clone().sub(m.position).normalize().multiplyScalar(2.4);
        m.userData.v.lerp(desired, 0.12 * f);
        m.lookAt(m.position.clone().add(m.userData.v));
      }
      m.userData.smokeTimer -= f;
      if (m.userData.smokeTimer <= 0){
        const back = new THREE.Vector3(0, 0, -1.5).applyQuaternion(m.quaternion);
        spawnSmoke(m.position.clone().add(back), 0.8, 0xdddddd, 1.4);
        m.userData.smokeTimer = 1 + Math.random() * 1.5;
      }
      m.position.add(m.userData.v.clone().multiplyScalar(f));
      m.userData.life -= f;
      if (m.userData.life <= 0){ explode(m.position); scene.remove(m); missiles.splice(i,1); }
      continue;
    }
    if (tgt && tgt.parent){
      const desired = tgt.position.clone().sub(m.position).normalize().multiplyScalar(2.4);
      m.userData.v.lerp(desired, 0.14 * f);
      m.lookAt(m.position.clone().add(m.userData.v));
      if (m.position.distanceTo(tgt.position) < 4.5){
        let idx = enemies.indexOf(tgt);
        if (idx >= 0){
          explode(tgt.position); scene.remove(tgt); enemies.splice(idx,1); updateCount();
          if (lockedTarget === tgt){ lockedTarget = null; lockProgress = 0; }
          scene.remove(m); missiles.splice(i,1); continue;
        }
        idx = groundEnemies.indexOf(tgt);
        if (idx >= 0){
          const g = tgt;
          g.userData.hp -= 2;
          explode(m.position);
          if (g.userData.hp <= 0){
            explode(g.position); scene.remove(g); groundEnemies.splice(idx,1); updateCount();
            if (lockedTarget === g){ lockedTarget = null; lockProgress = 0; }
          }
          scene.remove(m); missiles.splice(i,1); continue;
        }
        idx = bosses.indexOf(tgt);
        if (idx >= 0){
          const b = tgt;
          b.userData.hp -= 2;
          explode(m.position);
          if (b.userData.hp <= 0){
            explode(b.position); scene.remove(b); bosses.splice(idx,1); updateCount();
            if (lockedTarget === b){ lockedTarget = null; lockProgress = 0; }
          }
          scene.remove(m); missiles.splice(i,1); continue;
        }
        const u = getFleetUnitForMesh(tgt);
        if (u){
          u.hp--;
          explode(m.position);
          if (u.hp <= 0){
            explode(u.mesh.position); scene.remove(u.mesh);
            const fidx = fleetUnits.indexOf(u);
            if (fidx >= 0) fleetUnits.splice(fidx,1);
            updateCount();
            if (lockedTarget === u.mesh){ lockedTarget = null; lockProgress = 0; }
          }
          scene.remove(m); missiles.splice(i,1); continue;
        }
      }
    }
    m.userData.life -= f;
    if (m.userData.life <= 0){ explode(m.position); scene.remove(m); missiles.splice(i,1); continue; }
    m.userData.smokeTimer -= f;
    if (m.userData.smokeTimer <= 0){
      const back = new THREE.Vector3(0, 0, -1.5).applyQuaternion(m.quaternion);
      spawnSmoke(m.position.clone().add(back), 0.8, 0xdddddd, 1.4);
      m.userData.smokeTimer = 1 + Math.random() * 1.5;
    }
    m.position.add(m.userData.v.clone().multiplyScalar(f));
  }

  for (let i=enemyMissiles.length-1; i>=0; i--){
    const m = enemyMissiles[i];
    const tgt = m.userData.target;
    const inner = m.userData.innerFlame, outer = m.userData.outerFlame;
    if (inner && outer){
      const flicker = 0.85 + Math.random() * 0.3;
      inner.scale.setScalar(flicker); outer.scale.setScalar(flicker);
    }
    if (!m.userData.distracted){
      for (const fl of flares){
        if (m.position.distanceTo(fl.position) < 60){
          m.userData.target = fl;
          m.userData.distracted = true;
          break;
        }
      }
    }
    if (m.userData.willMiss){
      m.userData.missPhase += f;
      if (m.userData.missPhase > 40){
        const desired = tgt
          ? tgt.position.clone().sub(m.position).normalize().multiplyScalar(1.4)
          : m.userData.v.clone().normalize().multiplyScalar(1.4);
        const missDir = new THREE.Vector3(Math.sin(m.userData.missPhase*0.05), 0.2, Math.cos(m.userData.missPhase*0.07)).normalize();
        desired.lerp(missDir.multiplyScalar(3.0), 0.4);
        m.userData.v.lerp(desired, 0.12 * f);
        m.lookAt(m.position.clone().add(m.userData.v));
      } else if (tgt && !crashed){
        const desired = tgt.position.clone().sub(m.position).normalize().multiplyScalar(1.4);
        m.userData.v.lerp(desired, 0.06 * f);
        m.lookAt(m.position.clone().add(m.userData.v));
      }
    } else {
      if (tgt && !crashed){
        const desired = tgt.position.clone().sub(m.position).normalize().multiplyScalar(1.4);
        m.userData.v.lerp(desired, 0.06 * f);
        m.lookAt(m.position.clone().add(m.userData.v));
        if (m.position.distanceTo(tgt.position) < 2.4){
          const hitFlare = tgt.userData && tgt.userData.isFlare;
          explode(m.position);
          scene.remove(m);
          enemyMissiles.splice(i, 1);
          if (!hitFlare && !isLanded) playerHit('missile');
          continue;
        }
      }
    }
    m.userData.smokeTimer -= f;
    if (m.userData.smokeTimer <= 0){
      const back = new THREE.Vector3(0, 0, -1.5).applyQuaternion(m.quaternion);
      spawnSmoke(m.position.clone().add(back), 0.8, 0xbbbbbb, 1.4);
      m.userData.smokeTimer = 1 + Math.random() * 1.5;
    }
    m.position.add(m.userData.v.clone().multiplyScalar(f));
    m.userData.life -= f;
    if (m.userData.life <= 0){ scene.remove(m); enemyMissiles.splice(i,1); }
  }

  updateSmoke(f);

  for (let i=enemies.length-1; i>=0; i--){
    const e = enemies[i];
    const ud = e.userData;

    let nearestMissile = null, nearestDist = Infinity;
    for (const m of missiles){
      const d = m.position.distanceTo(e.position);
      if (d < 120 && d < nearestDist){ nearestDist = d; nearestMissile = m; }
    }
    if (nearestMissile){
      ud.incomingMissile = nearestMissile;
      if (!ud.evading){
        ud.evading = true;
        ud.evadeTimer = 30 + Math.random() * 30;
        const toMissile = nearestMissile.position.clone().sub(e.position).normalize();
        ud.evadeDir.set(-toMissile.z, (Math.random() - 0.5) * 0.6, toMissile.x).normalize();
        ud.speed = ud.baseSpeed * 1.35;
      }
    } else {
      ud.incomingMissile = null;
      if (ud.evading){
        ud.evadeTimer -= f;
        if (ud.evadeTimer <= 0){ ud.evading = false; ud.speed = ud.baseSpeed; }
      }
    }

    if (ud.beingLocked){
      if (ud.lockEvadeTimer <= 0){
        ud.lockEvadeTimer = 60 + Math.random() * 40;
        const toPlayer = playerPlane.position.clone().sub(e.position).normalize();
        const randomPerp = new THREE.Vector3(-toPlayer.z, (Math.random()-0.5)*0.5, toPlayer.x).normalize();
        ud.evadeDir.copy(randomPerp);
        ud.evading = true;
      }
    }
    if (ud.lockEvadeTimer > 0){
      ud.lockEvadeTimer -= f;
      if (ud.lockEvadeTimer <= 0){
        ud.evading = false;
      }
    }

    if (ud.evading){
      const targetPos = e.position.clone().add(ud.evadeDir.clone().multiplyScalar(60));
      tmpTarget.copy(targetPos).sub(e.position).normalize();
      steerPlaneToward(e, tmpTarget, ud.pitchRate * 1.5, ud.yawRate * 1.5, f);
    } else {
      ud.orbitAngle += ud.orbitSpeed * dt * 0.5;
      const targetX = playerPlane.position.x + Math.cos(ud.orbitAngle) * ud.orbitRadius;
      const targetZ = playerPlane.position.z + Math.sin(ud.orbitAngle) * ud.orbitRadius;
      const targetY = playerPlane.position.y + ud.preferredAltitudeOffset;
      tmpTarget.set(targetX, targetY, targetZ).sub(e.position).normalize();
      steerPlaneToward(e, tmpTarget, ud.pitchRate, ud.yawRate, f);
    }
    const forwardNow = new THREE.Vector3(0,0,1).applyQuaternion(e.quaternion);
    const horizontalDirToTarget = new THREE.Vector3(tmpTarget.x, 0, tmpTarget.z).normalize();
    const horizontalForward    = new THREE.Vector3(forwardNow.x, 0, forwardNow.z).normalize();
    const cross = horizontalForward.clone().cross(horizontalDirToTarget);
    const yawSign = Math.sign(cross.y);
    const targetRoll = yawSign * (ud.evading ? 0.5 : 0.3);
    ud.currentRoll += (targetRoll - ud.currentRoll) * 0.08 * f;
    const model = e.children[0];
    if (model) model.rotation.z = ud.currentRoll;
    e.position.add(forwardNow.clone().multiplyScalar(ud.speed * f));

    const distToPlayer = e.position.distanceTo(playerPlane.position);
    const toP = playerPlane.position.clone().sub(e.position).normalize();
    const facing = forwardNow.dot(toP);

    if (!crashed && !isLanded && !ud.evading && distToPlayer < ENEMY_LOCK_RANGE){
      if (facing > ENEMY_LOCK_CONE){
        ud.lockProgress = Math.min(100, ud.lockProgress + ENEMY_LOCK_RATE * dt);
      } else {
        ud.lockProgress = Math.max(0, ud.lockProgress - 60 * dt);
      }
      if (facing > 0.88){
        ud.gunCooldown -= f;
        if (ud.gunCooldown <= 0){
          enemyFireMachineGun(e);
          ud.gunCooldown = ENEMY_MG_CD;
        }
      }
      if (ud.lockProgress >= 100 && !ud.hasMissileInFlight){
        enemyFireMissile(e);
        ud.hasMissileInFlight = true;
        ud.lockProgress = 0;
        setTimeout(() => { ud.hasMissileInFlight = false; }, 9000);
      }
    } else {
      ud.lockProgress = Math.max(0, ud.lockProgress - 60 * dt);
    }

    const enemyGround = terrainHeightAt(e.position.x, e.position.z);
    if (e.position.y <= enemyGround + 1){
      explode(e.position); scene.remove(e); enemies.splice(i,1); updateCount();
      if (lockedTarget === e){ lockedTarget = null; lockProgress = 0; }
      continue;
    }
    if (e.position.distanceTo(playerPlane.position) > 2500){
      scene.remove(e); enemies.splice(i,1); updateCount();
    }
  }

  for (let i=bosses.length-1; i>=0; i--){
    const b = bosses[i];
    const ud = b.userData;
    ud.orbitAngle += 0.005 * f;
    const targetX = playerPlane.position.x + Math.cos(ud.orbitAngle) * ud.orbitRadius;
    const targetZ = playerPlane.position.z + Math.sin(ud.orbitAngle) * ud.orbitRadius;
    const targetY = playerPlane.position.y + 40;
    tmpTarget.set(targetX, targetY, targetZ).sub(b.position).normalize();
    steerPlaneToward(b, tmpTarget, ud.pitchRate, ud.yawRate, f);
    const forwardNow = new THREE.Vector3(0,0,1).applyQuaternion(b.quaternion);
    b.position.add(forwardNow.clone().multiplyScalar(ud.speed * f));
    ud.gunTimer -= f;
    if (ud.gunTimer <= 0){
      for (let s = -1; s <= 1; s++){
        const fwd = new THREE.Vector3(s * 0.4, 0, 1).normalize().applyQuaternion(b.quaternion);
        const start = b.position.clone().add(fwd.clone().multiplyScalar(6));
        const bb = new THREE.Mesh(new THREE.SphereGeometry(0.3,4,4),
          new THREE.MeshStandardMaterial({ color:0xff2200, emissive:0x881100 }));
        bb.position.copy(start);
        bb.userData = { v: fwd.clone().multiplyScalar(4.0), life:200 };
        scene.add(bb); enemyBullets.push(bb);
      }
      ud.gunTimer = 100 + Math.random()*80;
    }
    ud.missileTimer -= f;
    if (ud.missileTimer <= 0){
      const toPlayer = playerPlane.position.clone().sub(b.position).normalize();
      const start = b.position.clone().add(toPlayer.clone().multiplyScalar(6));
      const m = buildMissileModel(0xff2222, 0xff2200);
      m.position.copy(start);
      m.lookAt(start.clone().add(toPlayer));
      m.userData = {
        v: toPlayer.clone().multiplyScalar(1.5),
        target: playerPlane,
        life: 900,
        isEnemy: true,
        smokeTimer: 0,
        willMiss: Math.random() < MISSILE_MISS_CHANCE,
        missPhase: 0
      };
      scene.add(m); enemyMissiles.push(m);
      ud.missileTimer = 300 + Math.random()*200;
    }
  }

  for (let i=groundEnemies.length-1; i>=0; i--){
    const g = groundEnemies[i];
    const ud = g.userData;
    const distToPlayer = g.position.distanceTo(playerPlane.position);
    if (distToPlayer < 500){
      g.lookAt(playerPlane.position.x, g.position.y, playerPlane.position.z);
      const eFwd = new THREE.Vector3(0,0,1).applyQuaternion(g.quaternion);
      const toP = playerPlane.position.clone().sub(g.position).normalize();
      const facing = eFwd.dot(toP);
      ud.gunTimer -= f;
      if (ud.gunTimer <= 0 && facing > 0.5 && distToPlayer < 400){
        const from = g.position.clone(); from.y += 3.5;
        const toPlayer = playerPlane.position.clone().sub(from).normalize();
        const b = new THREE.Mesh(new THREE.SphereGeometry(0.18,4,4),
          new THREE.MeshStandardMaterial({ color:0xff8833, emissive:0x883300 }));
        b.position.copy(from);
        b.userData = { v: toPlayer.clone().multiplyScalar(4.5), life:200 };
        scene.add(b); enemyBullets.push(b);
        ud.gunTimer = 90 + Math.random()*70;
      } else if (ud.gunTimer < -80){ ud.gunTimer = 40; }
      if (facing > 0.7 && distToPlayer < 350){
        ud.lockProgress += 0.35 * f;
        if (ud.lockProgress >= 100 && !ud.hasMissileInFlight){
          enemyFireMissile(g);
          ud.lockProgress = 0;
          ud.hasMissileInFlight = true;
          setTimeout(() => { ud.hasMissileInFlight = false; }, 9000);
        }
      } else { ud.lockProgress = Math.max(0, ud.lockProgress - 1.0 * f); }
    } else { ud.lockProgress = Math.max(0, ud.lockProgress - 0.5 * f); }
  }

  if (fleetActive) updateFleet(dt, f);

  for (let i=bullets.length-1; i>=0; i--){
    const b = bullets[i];
    if (b.userData.life === undefined) continue;
    let hit = false;
    for (let j=enemies.length-1; j>=0; j--){
      const e = enemies[j];
      if (b.position.distanceTo(e.position) < 3.0){
        explode(e.position); scene.remove(e); enemies.splice(j,1); updateCount();
        if (lockedTarget === e){ lockedTarget = null; lockProgress = 0; }
        scene.remove(b); bullets.splice(i,1); hit = true; break;
      }
    }
    if (hit) continue;
    for (let j=groundEnemies.length-1; j>=0; j--){
      const g = groundEnemies[j];
      if (b.position.distanceTo(g.position) < 4){
        g.userData.hp--;
        explode(b.position);
        if (g.userData.hp <= 0){
          explode(g.position); scene.remove(g); groundEnemies.splice(j,1); updateCount();
          if (lockedTarget === g){ lockedTarget = null; lockProgress = 0; }
        }
        scene.remove(b); bullets.splice(i,1); hit = true; break;
      }
    }
    if (hit) continue;
    for (let j=bosses.length-1; j>=0; j--){
      const bo = bosses[j];
      if (b.position.distanceTo(bo.position) < 6){
        bo.userData.hp--;
        explode(b.position);
        if (bo.userData.hp <= 0){
          explode(bo.position); scene.remove(bo); bosses.splice(j,1); updateCount();
          if (lockedTarget === bo){ lockedTarget = null; lockProgress = 0; }
        }
        scene.remove(b); bullets.splice(i,1); hit = true; break;
      }
    }
    if (hit) continue;
    for (let j=fleetUnits.length-1; j>=0; j--){
      const u = fleetUnits[j];
      if (!u.mesh.parent) continue;
      if (b.position.distanceTo(u.mesh.position) < 4){
        u.hp--;
        explode(b.position);
        if (u.hp <= 0){
          explode(u.mesh.position); scene.remove(u.mesh); fleetUnits.splice(j,1); updateCount();
          if (lockedTarget === u.mesh){ lockedTarget = null; lockProgress = 0; }
        }
        scene.remove(b); bullets.splice(i,1); hit = true; break;
      }
    }
  }

  drawRadar();
  renderer.render(scene, camera);
}

// ================= START SCREEN HANDLER =================
document.getElementById('flyBtn').addEventListener('click', () => {
  rebuildPlayerPlane(selectedPlane);
  document.getElementById('startScreen').style.display = 'none';
  gameActive = true;
  startRound(1);
  showBigMessage('✈️ ' + PLANE_TYPES[selectedPlane].name, 'GOOD LUCK PILOT', 2500);
});

animate();

addEventListener('resize', ()=>{
  camera.aspect = innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
