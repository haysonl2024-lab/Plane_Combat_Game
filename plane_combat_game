// ================= CAMERA / HEAD DRAG =================
const canvas = renderer.domElement;
function onDragStart(x, y){ isDragging = true; lastDragX = x; lastDragY = y; }
function onDragMove(x, y){
  if (!isDragging) return;
  const dx = x - lastDragX, dy = y - lastDragY;
  lastDragX = x; lastDragY = y;
  if (firstPerson){
    headYaw   -= dx * 0.006;
    headPitch -= dy * 0.005;
    headPitch = Math.max(HEAD_PITCH_MIN, Math.min(HEAD_PITCH_MAX, headPitch));
  } else {
    camYaw   -= dx * 0.006;
    camPitch += dy * 0.004;
    camPitch = Math.max(CAM_PITCH_MIN, Math.min(CAM_PITCH_MAX, camPitch));
  }
}
