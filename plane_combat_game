function updateFleet(dt, f){
  if (!fleetActive) return;
  fleetTimeLeft -= dt;
  if (fleetTimeLeft < 0) fleetTimeLeft = 0;
  timerValueEl.textContent = fmtTime(fleetTimeLeft);
  if (fleetTimeLeft <= 15) timerEl.classList.add('urgent');
  else timerEl.classList.remove('urgent');
  if (fleetTimeLeft <= 0){ endGame('⏱️ TIME UP', 'The fleet escaped.'); return; }
  for (const u of fleetUnits){
    if (!u.mesh.parent) continue;
    u.mesh.position.z += u.speed * f;
    if (u.type === 'tank'){
      const dx = playerPlane.position.x - u.mesh.position.x;
      const dz = playerPlane.position.z - u.mesh.position.z;
      u.mesh.rotation.y = Math.atan2(dx, dz);
    }
    const distToPlayer = u.mesh.position.distanceTo(playerPlane.position);
    if (!crashed && distToPlayer < 500){
      u.fireTimer -= f;
      if (u.fireTimer <= 0 && distToPlayer < 400){
        const from = u.mesh.position.clone(); from.y += 2;
        const toPlayer = playerPlane.position.clone().sub(from).normalize();
        const b = new THREE.Mesh(new THREE.SphereGeometry(0.18,4,4),
          new THREE.MeshStandardMaterial({ color:0xff8833, emissive:0x883300 }));
        b.position.copy(from);
        b.userData = { v: toPlayer.clone().multiplyScalar(4.5), life:200 };
        scene.add(b); enemyBullets.push(b);
        u.fireTimer = 70 + Math.random() * 60;
      }
      if (distToPlayer < 400){
        u.lockProgress += 0.25 * f;
        if (u.lockProgress >= 100 && !u.hasMissileInFlight){
          const from = u.mesh.position.clone(); from.y += 2.5;
          const toPlayer = playerPlane.position.clone().sub(from).normalize();
          const m = buildMissileModel(0xdd6622, 0xff6600);
          m.position.copy(from);
          m.lookAt(from.clone().add(toPlayer));
          m.userData = {
            v: toPlayer.clone().multiplyScalar(1.3),
            target: playerPlane,
            life: 900,
            isEnemy: true,
            smokeTimer: 0,
            willMiss: Math.random() < MISSILE_MISS_CHANCE,
            missPhase: 0
          };
          scene.add(m); enemyMissiles.push(m);
          u.lockProgress = 0;
          u.hasMissileInFlight = true;
          setTimeout(() => { u.hasMissileInFlight = false; }, 6000);
        }
      } else {
        u.lockProgress = Math.max(0, u.lockProgress - 1.0 * f);
      }
    }
  }
  if (fleetUnits.length === 0){
    fleetActive = false;
    timerEl.classList.remove('show');
    showBigMessage('🎉 FLEET DESTROYED', 'MISSION COMPLETE', 4000);
    setTimeout(() => endGame('🏆 MISSION COMPLETE', 'You destroyed the fleet!'), 2000);
  }
}

// ================= PLAYER LOCK-ON =================
const LOCK_RATE = 140;
const lockRange = 500;
const lockCone  = 0.90;
const lockBreakRange = lockRange * 1.4;
const lockBreakCone  = 0.80;
let lockedTarget = null, lockProgress = 0;

function makeBrackets(){
  const size = 128;
  const c = document.createElement('canvas');
  c.width = c.height = size;
  const ctx = c.getContext('2d');
  ctx.strokeStyle = '#ff2222'; ctx.lineWidth = 8;
  const m = 16, s = size;
  ctx.beginPath();
  ctx.moveTo(m, m+24); ctx.lineTo(m, m); ctx.lineTo(m+24, m);
  ctx.moveTo(s-m-24, m); ctx.lineTo(s-m, m); ctx.lineTo(s-m, m+24);
  ctx.moveTo(s-m, s-m-24); ctx.lineTo(s-m, s-m); ctx.lineTo(s-m-24, s-m);
  ctx.moveTo(m+24, s-m); ctx.lineTo(m, s-m); ctx.lineTo(s-m-24, s-m);
  ctx.stroke();
  const tex = new THREE.CanvasTexture(c);
  const spr = new THREE.Sprite(new THREE.SpriteMaterial({ map:tex, depthTest:false, transparent:true }));
  spr.scale.set(7,7,1); spr.visible = false;
  scene.add(spr); return spr;
}
const bracketSprite = makeBrackets();

function allTargets(){
  const targets = [...enemies, ...groundEnemies, ...bosses];
  for (const u of fleetUnits) if (u.mesh.parent) targets.push(u.mesh);
  return targets;
}
function getFleetUnitForMesh(mesh){
  for (const u of fleetUnits) if (u.mesh === mesh) return u;
  return null;
}
function isTargetAlive(tgt){
  if (!tgt) return false;
  if (!tgt.parent) return false;
  if (enemies.indexOf(tgt) >= 0) return true;
  if (groundEnemies.indexOf(tgt) >= 0) return true;
  if (bosses.indexOf(tgt) >= 0) return true;
  if (getFleetUnitForMesh(tgt)) return true;
  return false;
}

function updatePlayerLock(dt){
  const fwd = new THREE.Vector3(0,0,1).applyQuaternion(playerPlane.quaternion);
  if (lockedTarget){
    if (!isTargetAlive(lockedTarget)){
      lockedTarget = null;
      lockProgress = 0;
    } else {
      const toT = lockedTarget.position.clone().sub(playerPlane.position);
      const dist = toT.length();
      const dot = toT.normalize().dot(fwd);
      if (dist > lockBreakRange || dot < lockBreakCone){
        lockedTarget = null;
        lockProgress = 0;
      }
    }
  }
  if (!lockedTarget){
    let best = null, bestDist = Infinity;
    for (const e of allTargets()){
      const toE = e.position.clone().sub(playerPlane.position);
      const dist = toE.length();
      if (dist > lockRange) continue;
      toE.normalize();
      if (fwd.dot(toE) < lockCone) continue;
      if (dist < bestDist){ bestDist = dist; best = e; }
    }
    if (best){
      lockedTarget = best;
      lockProgress = 0;
    }
  }
  for (const e of enemies){
    if (lockedTarget === e && lockProgress > 0 && lockProgress < 100){
      e.userData.beingLocked = true;
    } else {
      e.userData.beingLocked = false;
    }
  }
  if (!lockedTarget){
    lockHud.classList.remove('show','locked');
    bracketSprite.visible = false;
    missileInfo.textContent = 'LOCK A TARGET FIRST';
    btnMissile.classList.remove('ready');
    return;
  }
  lockProgress = Math.min(100, lockProgress + LOCK_RATE * dt);
  lockHud.classList.add('show');
  lockFill.style.width = lockProgress + '%';
  lockPct.textContent = Math.floor(lockProgress) + '%';
  if (lockProgress >= 100){
    lockHud.classList.add('locked');
    lockLabel.textContent = '🔒 TARGET LOCKED';
    bracketSprite.visible = true;
    bracketSprite.position.copy(lockedTarget.position);
    missileInfo.textContent = 'FIRE! FIRE! FIRE!';
    btnMissile.classList.add('ready');
  } else {
    lockHud.classList.remove('locked');
    lockLabel.textContent = 'LOCKING...';
    bracketSprite.visible = false;
    missileInfo.textContent = 'LOCKING TARGET...';
    btnMissile.classList.remove('ready');
  }
}

